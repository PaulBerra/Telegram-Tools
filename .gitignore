# ===========================================================================
# Telegram Tools - .gitignore
# ===========================================================================
*.session
*.session-journal
.telegram_tools/
tokens.json
.env
.env.*
*.env

# ---- Captured data / dumps / downloaded media ----------------------------
*.ndjson
*.jsonl
media/
downloads/

# Ad-hoc screenshots (the app logo is logo.png/logo.ico and is kept)
screenshot_*.png

# ---- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# ---- Virtual environments ------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ---- Test / lint / type-check caches -------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# ---- Editors / IDEs ------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace

# ---- OS noise ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
